{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@blasphem/core#check": {
      "inputs": [
        "$TURBO_DEFAULT$"
      ]
    },
    "@blasphem/packs#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/packs.mjs",
        "$TURBO_ROOT$/resources/packs/**"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@blasphem/node#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/rust-toolchain.toml",
        "$TURBO_ROOT$/.cargo/**",
        "$TURBO_ROOT$/crates/**"
      ],
      "outputs": [
        "npm/*/*.node"
      ]
    },
    "@blasphem/cli#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/rust-toolchain.toml",
        "$TURBO_ROOT$/.cargo/**",
        "$TURBO_ROOT$/crates/**",
        "$TURBO_ROOT$/resources/lexicon/**",
        "$TURBO_ROOT$/resources/models/**",
        "$TURBO_ROOT$/resources/packs/**"
      ],
      "outputs": [
        "npm/*/bin/**"
      ]
    },
    "blasphem#build": {
      "env": [
        "BLASPHEM_WASM_PREBUILT"
      ],
      "dependsOn": [
        "@blasphem/core#check",
        "@blasphem/packs#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/NOTICE",
        "$TURBO_ROOT$/scripts/copy-notice.mjs",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/rust-toolchain.toml",
        "$TURBO_ROOT$/.cargo/**",
        "$TURBO_ROOT$/crates/**",
        "$TURBO_ROOT$/packages/javascript-common/src/**",
        "$TURBO_ROOT$/resources/packs/manifest.json"
      ],
      "outputs": [
        "dist/**",
        "NOTICE",
        "src/blasphem.js",
        "src/blasphem.d.ts",
        "src/blasphem_bg.wasm",
        "src/blasphem_bg.wasm.d.ts",
        "src/blasphem.prebuilt.json"
      ]
    },
    "blasphem#test": {
      "dependsOn": [
        "blasphem#build",
        "@blasphem/packs#build",
        "@blasphem/node#build",
        "@blasphem/cli#build"
      ],
      "cache": false
    },
    "@blasphem/react-native#build": {
      "dependsOn": [
        "@blasphem/core#check",
        "blasphem#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/javascript-common/src/**",
        "$TURBO_ROOT$/packages/apple/Sources/Blasphem/BlasphemFileIO.swift",
        "$TURBO_ROOT$/packages/apple/Sources/Blasphem/BlasphemDownloadStore.swift",
        "$TURBO_ROOT$/packages/android/engine/src/main/kotlin/me/sospedra/blasphem/BlasphemRemoteStore.kt",
        "$TURBO_ROOT$/resources/packs/manifest.json"
      ],
      "outputs": [
        "dist/**",
        "src/version.generated.ts",
        "ios/BlasphemFileIO.swift",
        "ios/BlasphemDownloadStore.swift",
        "android/src/main/java/com/margelo/nitro/blasphem/BlasphemRemoteStore.kt",
        "android/src/main/java/com/margelo/nitro/blasphem/Release.generated.kt"
      ]
    },
    "web#build": {
      "dependsOn": [
        "blasphem#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/resources/packs/**",
        "$TURBO_ROOT$/packages/javascript-common/src/**"
      ],
      "outputs": [
        "dist/**"
      ],
      "env": [
        "SITE_URL"
      ]
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "check": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#reproduce": {
      "cache": false
    },
    "//#regenerate": {
      "cache": false
    }
  }
}
