{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "blasphem#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/rust-toolchain.toml",
        "$TURBO_ROOT$/.cargo/**",
        "$TURBO_ROOT$/src/**",
        "$TURBO_ROOT$/crates/**",
        "$TURBO_ROOT$/data/raw-v1/hurtlex/**",
        "$TURBO_ROOT$/resources/models/**"
      ],
      "outputs": ["dist/**"]
    },
    "blasphem#test": {
      "dependsOn": ["blasphem#build"],
      "cache": false
    },
    "web#build": {
      "dependsOn": ["blasphem#build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/reports/**"],
      "outputs": ["dist/**"],
      "env": ["SITE_URL"]
    },
    "test": {
      "dependsOn": ["build"],
      "cache": false
    },
    "check": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#reproduce": {
      "cache": false
    },
    "//#regenerate": {
      "cache": false
    }
  }
}
