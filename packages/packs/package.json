{
  "name": "@blasphem/packs",
  "version": "0.1.0",
  "description": "Per-locale data for blasphem: one .pack and one .detect file per language, plus manifest.json with a sha256 per file.",
  "license": "CC-BY-NC-SA-4.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sospedra/blasphem.git",
    "directory": "packages/packs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.13.0"
  },
  "exports": {
    "./package.json": "./package.json",
    "./manifest.json": "./dist/manifest.json",
    "./files": {
      "types": "./dist/files.d.ts",
      "default": "./dist/files.js"
    },
    "./*": "./dist/*"
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node ../../scripts/copy-notice.mjs"
  }
}
