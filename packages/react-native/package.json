{
  "name": "@blasphem/react-native",
  "version": "1.0.0",
  "description": "Local toxicity checks for React Native through Nitro Modules. Blasphem hashes word and character n-grams into sparse feature vectors. A linear classifier trained offline scores them with 16-bit weights. Lexicons and context rules contribute to the verdict. Detection runs locally without neural networks or cloud inference.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sospedra/blasphem.git",
    "directory": "packages/react-native"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.13.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "browser": "./dist/web.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./app.plugin": "./app.plugin.cjs"
  },
  "files": [
    "dist",
    "cpp",
    "ios",
    "android",
    "nitrogen/generated",
    "nitro.json",
    "app.plugin.cjs",
    "scripts/bundle-assets.cjs",
    "*.podspec",
    "README.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node ../../scripts/copy-notice.mjs",
    "check": "tsc --noEmit --project tsconfig.json",
    "nitrogen": "nitrogen",
    "build:rust": "node scripts/rust.mjs"
  },
  "dependencies": {
    "@blasphem/packs": "workspace:*",
    "blasphem": "workspace:*"
  },
  "peerDependencies": {
    "@expo/config-plugins": "57.0.9",
    "react-native": "0.86.3",
    "react-native-nitro-modules": "0.37.1"
  },
  "peerDependenciesMeta": {
    "@expo/config-plugins": {
      "optional": true
    }
  },
  "devDependencies": {
    "@expo/config-plugins": "57.0.9",
    "@types/node": "24.10.1",
    "nitrogen": "0.37.1",
    "react-native": "0.86.3",
    "react-native-nitro-modules": "0.37.1",
    "typescript": "5.9.3"
  }
}
