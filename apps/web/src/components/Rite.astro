---
import { resolve } from "node:path";
import { pathToFileURL } from "node:url";
import type { Judge, JudgeOptions } from "blasphem";
import { LANGUAGES } from "../lib/languages";
import { smoke } from "../lib/reports";
import Numeral from "./Numeral.astro";
import Spread from "./Spread.astro";

const example = smoke.languages.ES.cases.find((entry) => entry.case_id === "supplied-es-toxic");
if (!example) throw new Error("the smoke report lacks supplied-es-toxic");
const codes = LANGUAGES.map((language) => language.code).join(", ");

// Run the real package at build time so the sample cannot drift from it.
// The import stays dynamic and absolute so Vite leaves the Node entry alone.
const entry = pathToFileURL(resolve(process.cwd(), "../../packages/blasphem/dist/node.js")).href;
const { createJudge } = (await import(/* @vite-ignore */ entry)) as {
  createJudge: (options: JudgeOptions) => Promise<Judge>;
};
const buildJudge = await createJudge({
  locales: ["es"],
  detectLanguage: false,
  grawlix: true,
  assets: resolve(process.cwd(), "../../packages/packs/dist"),
});
const verdict = buildJudge.judge(example.text);
buildJudge.close();

const fields = [
  ["safe", "boolean", "True when no nudge is due. Also true when no locale routed the text."],
  ["score", "number 0 to 1", "Ordinal. Higher means more evidence. Not a probability, not calibrated across languages."],
  ["locale", "string or null", "The locale that produced the score. Null when nothing routed the text."],
  ["grawlix", "string or null", "The masked text, when the grawlix option is set. Null otherwise."],
] as const;

const options = [
  ["locales", "string[]", "Locales to load, lowercase. Required. Only these download."],
  ["assets", "string", "Browser: the path that serves the wasm and the packs. Required there. Node: optional packs directory."],
  ["detectLanguage", "boolean", "Route by detected language. Defaults to true. Loads one .detect slice per locale."],
  ["grawlix", "boolean", "Return the masked text. Defaults to false."],
] as const;
---
<Spread id="rite" label="the rite" class="ch rite">
  <div class="page r mirror">
    <Numeral value="II" class="two" />
    <p class="rubric">chapter two</p>
    <h2 id="rite-title" class="title">One import, one call</h2>
    <p class="copy">Build a judge once with the locales you need. Then call <code>judge()</code> as often as the keystrokes come. The same packs judge the same text the same way in every browser, in Node, and in React Native.</p>
    <p class="copy">With <code>detectLanguage</code> the router identifies the language before the toxicity check. Text it cannot route returns <code>locale: null</code> and <code>safe: true</code>. Nothing is judged. The nudge fails open by design.</p>
    <p class="copy"><code>judge()</code> is synchronous and returns a plain object. Call <code>close()</code> when a judge is no longer needed; after that, <code>judge()</code> throws <code>BLASPHEM_CLOSED</code>.</p>
    <table class="ledger fields">
      <caption>Judgement</caption>
      <thead><tr><th>field</th><th>type</th><th>meaning</th></tr></thead>
      <tbody>
        {fields.map(([name, type, meaning]) => (
          <tr><td>{name}</td><td class="us">{type}</td><td class="meaning">{meaning}</td></tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="page l">
    <pre><code><span class="c">// One import. createJudge loads the locales you name; judge() is synchronous.</span>
<span class="k">import</span> &#123; createJudge &#125; <span class="k">from</span> <span class="s">"blasphem"</span>;

<span class="k">const</span> judge = <span class="k">await</span> createJudge(&#123;
  locales: [<span class="s">"es"</span>],
  assets: <span class="s">"/blasphem"</span>,
  detectLanguage: <span class="k">false</span>,
  grawlix: <span class="k">true</span>,
&#125;);
<span class="k">const</span> v = judge.judge(<span class="s">{JSON.stringify(example.text)}</span>);

v.safe    <span class="c">// {String(verdict.safe)}</span>
v.score   <span class="c">// {verdict.score}, ordinal</span>
v.locale  <span class="c">// {JSON.stringify(verdict.locale)}</span>
v.grawlix <span class="c">// {JSON.stringify(verdict.grawlix)}</span></code></pre>
    <p class="evidence">values from {smoke.evidence_status.replaceAll("_", " ")}</p>

    <h3 class="sub">Install</h3>
    <p class="copy">The package is private and unpublished. Build it from a clone of <a href="https://github.com/sospedra/blasphem">sospedra/blasphem</a>:</p>
    <pre><code>pnpm install --frozen-lockfile
pnpm --filter @blasphem/packs run build
pnpm --filter blasphem run build
pnpm --filter blasphem pack</code></pre>
    <p class="copy">Then <code>pnpm add ./blasphem-0.1.0.tgz</code> in your app together with <code>@blasphem/packs</code>, or reference both as <code>workspace:*</code> inside this repository. In the browser, copy <code>blasphem_bg.wasm</code> and the packs into one public directory and pass it as <code>assets</code>. Serve <code>blasphem_bg.wasm</code> as <code>application/wasm</code>. Node reads the installed packs and runs the native binary of <code>@blasphem/node-*</code> when it is installed.</p>

    <h3 class="sub">Tongues</h3>
    <p class="copy"><code>{codes}</code>, lowercase, in <code>locales</code>. <code>id</code> is accepted as an alias for <code>ms</code>. Any other value throws. <code>locales</code> is required; the other options have defaults.</p>
    <table class="ledger fields">
      <caption>JudgeOptions</caption>
      <thead><tr><th>option</th><th>type</th><th>meaning</th></tr></thead>
      <tbody>
        {options.map(([name, type, meaning]) => (
          <tr><td>{name}</td><td class="us">{type}</td><td class="meaning">{meaning}</td></tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="spine" aria-hidden="true">one module &middot; deterministic &middot; offline after load</div>
</Spread>

<style>
  pre {
    margin: 0 0 18px;
    padding: 18px;
    overflow-x: auto;
    border: 1px solid var(--hair);
    background: #080707;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.85;
    color: #c3bcb4;
    tab-size: 2;
  }
  pre .k {
    color: var(--blood-ink);
  }
  pre .s {
    color: #e0a49e;
  }
  pre .c {
    color: var(--taupe);
    font-style: italic;
  }
  .sub {
    font-family: var(--font-goth);
    font-weight: 400;
    font-size: 26px;
    margin: 34px 0 8px;
    color: var(--bone);
  }
  :global(.rite) {
    min-height: 640px;
  }
  :global(.rite) .page.l {
    padding-top: 84px;
  }
  pre code {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .fields th,
  .fields td {
    text-align: left;
    vertical-align: top;
  }
  .fields .meaning {
    font-size: 14px;
    color: var(--parchment);
  }
  .fields caption {
    text-align: right;
  }
  .page.r.mirror .fields {
    text-align: left;
  }
  .spine {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%) rotate(180deg);
    writing-mode: vertical-rl;
    font-family: var(--font-rubric);
    font-size: 15px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--bone);
    background: var(--pitch);
    padding: 14px 0;
    z-index: 3;
    white-space: nowrap;
  }
  @media (max-width: 1023px) {
    :global(.rite) {
      min-height: 0;
    }
    :global(.rite) .page.l {
      padding-top: 64px;
    }
    .spine {
      display: none;
    }
    pre {
      font-size: 11.5px;
    }
  }
</style>
