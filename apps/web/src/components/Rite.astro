---
import { resolve } from "node:path";
import { pathToFileURL } from "node:url";
import { INSTALLATIONS } from "../lib/installation";
import { LANGUAGES } from "../lib/languages";
import CodeBlock from "./CodeBlock.astro";
import Ledger from "./Ledger.astro";
import Numeral from "./Numeral.astro";
import Spread from "./Spread.astro";

const entry = pathToFileURL(resolve(process.cwd(), "../../packages/javascript/dist/node.js")).href;
const api = (await import(/* @vite-ignore */ entry)) as typeof import("blasphem");
await api.init({ grawlix: true });
const verdict = api.judge("you are a stupid loser");
api.close();

const fields = [
  ["safe", "boolean", "True when no warning is due. Unrouted text also returns true."],
  ["score", "number · 0–1", "Evidence strength. A warning starts at 0.5. This is not a probability."],
  ["locale", "string | null", "The language used to judge the message. Null means no language matched."],
  ["grawlix", "string | null", "The masked message for unsafe verdicts when grawlix is enabled. Otherwise null."],
];
const options = [
  ["locales", "required", "Declare a nonempty locale array or all in application configuration."],
  ["detectLanguage", "true", "Detect the language before judging. If false, score every loaded language and use the highest score."],
  ["grawlix", "false", "Include a masked message for unsafe verdicts."],
  ["assets", "bundled", "Client configuration selects bundled data or pinned remote delivery. Node stays local."],
];
const groups = ["Clients", "Servers", "Terminal"] as const;
---
<Spread id="rite" label="the rite · installation" class="wide">
  <div class="stage">
    <header class="install-intro">
      <div>
        <Numeral value="II" />
        <p class="rubric">chapter two · installation</p>
        <h2 id="rite-title" class="title">At home in your stack.</h2>
      </div>
      <p class="copy">Web, Swift, Android, and React Native are first-class clients. Node.js, Python, Go, and Rust bring the same engine to your server. Choose your platform. Load your languages. Judge locally.</p>
    </header>

    <blasphem-install class="installer">
      <label class="mobile-platform">
        <span>Your platform</span>
        <select aria-label="Installation platform">
          {groups.map((group) => <optgroup label={group}>{INSTALLATIONS.filter((runtime) => runtime.group === group).map((runtime) => <option value={runtime.id}>{runtime.name}</option>)}</optgroup>)}
        </select>
      </label>
      <div class="platforms" role="tablist" aria-label="Installation platform" aria-orientation="vertical">
        {groups.map((group) => (
          <div class="platform-group" role="presentation">
            <span class="group-name">{group}</span>
            {INSTALLATIONS.filter((runtime) => runtime.group === group).map((runtime) => (
              <button type="button" role="tab" id={"tab-" + runtime.id} aria-controls={"install-" + runtime.id} aria-selected={runtime.id === "browser"} tabindex={runtime.id === "browser" ? 0 : -1}>
                {runtime.name}<span aria-hidden="true">↗</span>
              </button>
            ))}
          </div>
        ))}
      </div>
      <div class="platform-content">
        {INSTALLATIONS.map((runtime, index) => (
          <section id={"install-" + runtime.id} role="tabpanel" aria-labelledby={"tab-" + runtime.id} tabindex="0" hidden={index > 0}>
            <p class="platform-detail">{runtime.detail}</p>
            <CodeBlock {...runtime.install} />
            {runtime.setup && <CodeBlock {...runtime.setup} />}
            <CodeBlock {...runtime.example} />
            <div class="platform-notes">{runtime.notes.map((note) => <p class="copy">{note}</p>)}</div>
            {runtime.id === "browser" && (
              <details class="reference">
                <summary>Connect the browser build</summary>
                <CodeBlock label="vite.config.ts" lang="typescript" code={'import { defineConfig } from "vite";\nimport blasphem from "blasphem/vite";\n\nexport default defineConfig({ plugins: [blasphem()] });'} />
                <CodeBlock label="Other builds · publish selected assets" code={"pnpm exec blasphem-assets public/blasphem --base /blasphem"} />
                <CodeBlock label="Other builds · load configuration before your module" lang="html" code={'<script src="/blasphem/config.js"></script>'} />
                <p class="copy">Serve .wasm files as application/wasm. A Content Security Policy must allow WebAssembly and your asset origin.</p>
              </details>
            )}
            <a class="text-link" href={"https://github.com/sospedra/blasphem/tree/main/" + runtime.docs}>Read the {runtime.name} guide <span aria-hidden="true">↗</span></a>
          </section>
        ))}
      </div>
    </blasphem-install>

    <div class="api-intro">
      <div>
        <p class="rubric">one shared contract</p>
        <h3 class="sub">Initialize once. Judge often.</h3>
        <p class="copy">Initialization loads the engine and language packs. Each later check returns synchronously. Your app decides how to show the warning.</p>
        <p class="copy">This result comes from the installed package at build time.</p>
      </div>
      <CodeBlock label="Result for the example message" lang="json" code={JSON.stringify(verdict, null, 2)} />
    </div>

    <details class="reference api-reference">
      <summary>Options, results, and supported languages</summary>
      <div class="reference-tables">
        <Ledger id="options" caption="Application configuration and runtime behavior" columns={["Option", "Default", "Meaning"]} rows={options} prose={[2]} source="https://github.com/sospedra/blasphem/blob/main/packages/javascript-common/src/contract.ts" />
        <Ledger id="results" caption="Result fields" columns={["Field", "Type", "Meaning"]} rows={fields} prose={[2]} />
      </div>
      <p class="copy"><code>init()</code> installs the module judge. Before initialization and after <code>close()</code>, <code>judge()</code> returns the safe, empty result. Use <code>ready()</code> to check initialization.</p>
      <p class="copy"><code>createJudge()</code> creates an independent instance. Its <code>judge()</code> throws <code>BLASPHEM_CLOSED</code> after <code>close()</code>.</p>
      <div class="locale-list" aria-label="Supported locale codes">
        {LANGUAGES.map((language) => <span><code>{language.tag}</code>{language.name}</span>)}
      </div>
      <p class="copy">Use <code>id</code> for Indonesian and <code>ms</code> for Malay. Unknown locale codes produce an initialization error.</p>
    </details>
  </div>
</Spread>

<script>
  function selectTab(root: HTMLElement, selected: HTMLButtonElement): void {
    root.querySelector("select")!.value = selected.id.slice(4);
    for (const tab of root.querySelectorAll<HTMLButtonElement>('[role="tab"]')) {
      const active = tab === selected;
      tab.setAttribute("aria-selected", String(active));
      tab.tabIndex = active ? 0 : -1;
    }
    for (const panel of root.querySelectorAll<HTMLElement>('[role="tabpanel"]')) {
      panel.hidden = panel.id !== selected.getAttribute("aria-controls");
    }
  }

  function nextIndex(key: string, index: number, length: number): number {
    switch (key) {
      case "ArrowDown":
      case "ArrowRight": return (index + 1) % length;
      case "ArrowUp":
      case "ArrowLeft": return (index + length - 1) % length;
      case "Home": return 0;
      case "End": return length - 1;
      default: return index;
    }
  }

  function navigateTabs(root: HTMLElement, event: KeyboardEvent): void {
    const tab = (event.target as Element).closest<HTMLButtonElement>('[role="tab"]');
    const navigationKeys = ["ArrowDown", "ArrowRight", "ArrowUp", "ArrowLeft", "Home", "End"];
    if (!tab || !navigationKeys.includes(event.key)) return;
    event.preventDefault();
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const next = tabs[nextIndex(event.key, tabs.indexOf(tab), tabs.length)];
    selectTab(root, next);
    next.focus();
  }

  class BlasphemInstall extends HTMLElement {
    private events?: AbortController;

    connectedCallback(): void {
      this.events?.abort();
      this.events = new AbortController();
      const options = { signal: this.events.signal };
      this.addEventListener("click", (event) => {
        const tab = (event.target as Element).closest<HTMLButtonElement>('[role="tab"]');
        if (tab) selectTab(this, tab);
      }, options);
      this.addEventListener("keydown", (event) => navigateTabs(this, event), options);
      this.addEventListener("change", (event) => {
        if (!(event.target instanceof HTMLSelectElement)) return;
        const tab = this.querySelector<HTMLButtonElement>("#tab-" + event.target.value);
        if (tab) selectTab(this, tab);
      }, options);
    }

    disconnectedCallback(): void {
      this.events?.abort();
    }
  }

  if (!customElements.get("blasphem-install")) customElements.define("blasphem-install", BlasphemInstall);
</script>

<style>
  .install-intro { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: end; margin-bottom: 42px; }
  .install-intro :global(.numeral) { font-size: 110px; margin: 0 0 24px; }
  .install-intro .copy { max-width: 44ch; margin-bottom: 24px; font-size: 21px; line-height: 1.5; }
  .installer { display: grid; grid-template-columns: 200px minmax(0, 1fr); border: 1px solid var(--hair); border-top-color: var(--blood-hair); background: var(--pitch); }
  .mobile-platform { display: none; }
  .platforms { padding: 24px 16px; border-right: 1px solid var(--hair); }
  .platform-group + .platform-group { margin-top: 26px; }
  .group-name { display: block; padding: 0 12px 8px; font: 10px var(--font-rubric); letter-spacing: .2em; text-transform: uppercase; color: var(--taupe-ink); }
  .platforms button { width: 100%; min-height: 46px; display: flex; justify-content: space-between; align-items: center; gap: 12px; background: none; border: 1px solid transparent; padding: 10px 12px; text-align: left; color: var(--parchment); font: 17px var(--font-body); cursor: pointer; }
  .platforms button span { color: var(--blood-ink); opacity: 0; }
  .platforms button[aria-selected="true"] { border-color: var(--blood-hair); background: #231617; color: var(--bone); }
  .platforms button[aria-selected="true"] span { opacity: 1; }
  .platforms button:hover { color: var(--blood-ink); }
  .platform-content { min-width: 0; padding: 30px 36px; }
  .platform-detail { font: 11px/1.7 var(--font-mono); color: var(--taupe-ink); margin: 0; }
  .platform-notes .copy { max-width: 68ch; font-size: 17px; line-height: 1.55; overflow-wrap: anywhere; }
  .text-link { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; color: var(--bone); font-size: 17px; text-decoration-color: var(--blood-hair); text-underline-offset: 5px; }
  .text-link:hover { color: var(--blood-ink); }
  .api-intro { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; padding-top: 46px; }
  .sub { font: 400 34px/1.1 var(--font-goth); margin: 10px 0 20px; }
  .reference { border-top: 1px solid var(--hair); margin: 22px 0; }
  summary { padding: 18px 0; cursor: pointer; color: var(--bone); font-size: 18px; }
  summary::marker { color: var(--blood-ink); }
  .api-reference > summary { font: 400 27px/1.4 var(--font-goth); }
  .reference-tables { display: grid; gap: 24px; margin-top: 12px; }
  .api-reference .copy { max-width: 80ch; }
  .locale-list { display: flex; flex-wrap: wrap; gap: 8px; margin: 26px 0 18px; }
  .locale-list span { display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--hair); padding: 5px 10px; font-size: 15px; color: var(--parchment); }
  .locale-list code { color: var(--blood-ink); font: 11px var(--font-mono); }
  @media (max-width: 1023px) {
    .install-intro { grid-template-columns: 1fr; gap: 6px; }
    .installer { grid-template-columns: 160px minmax(0, 1fr); }
    .platform-content { padding: 24px; }
    .api-intro { gap: 28px; }
  }
  @media (max-width: 700px) {
    .installer, .api-intro { grid-template-columns: 1fr; }
    .platforms { display: none; }
    .mobile-platform { display: grid; gap: 10px; padding: 16px; border-bottom: 1px solid var(--hair); font: 11px var(--font-mono); color: var(--taupe-ink); }
    .mobile-platform select { width: 100%; min-height: 46px; border: 1px solid var(--blood-hair); border-radius: 0; padding: 10px 12px; background: var(--coal); color: var(--bone); font: 16px var(--font-body); }
    .platform-content { padding: 20px 14px; }
    .api-intro { gap: 0; }
    .install-intro .copy { font-size: 19px; }
  }
</style>
