---
import { formatInt, formatMegabytes, formatPercent } from "../lib/format";
import { benchmark, browser } from "../lib/reports";
import Spread from "./Spread.astro";

const matrix = benchmark.test.pooled.matrix;
const pooledPrecision = matrix.true_positive / (matrix.true_positive + matrix.false_positive);
const pooledRecall = matrix.true_positive / (matrix.true_positive + matrix.false_negative);
const cleanRows = matrix.false_positive + matrix.true_negative;
const cleanWarned = matrix.false_positive / cleanRows;
const startingSize = formatMegabytes(browser.browser_builds.explicit_only.brotli_total_bytes, 1);
---
<Spread id="credo" label="the credo">
  <div class="page l">
    <svg class="emblem" viewBox="0 0 80 96" aria-hidden="true"><use href="#sacredHeart"></use></svg>
    <p class="rubric">the credo</p>
    <h2 id="credo-title" class="title">A moment to reconsider.</h2>
    <p class="creed">The best time to change a message is before it leaves.</p>
    <p class="copy">Give the writer a quiet warning while the draft is still theirs. The text stays on their device. Your app chooses the words, the timing, and the next step.</p>
    <p class="copy">Start with a {startingSize} browser download for English without language detection. Add the languages your community uses.</p>
  </div>
  <div class="page r">
    <div class="antiphon">
      <p class="but">A warning. A chance to rewrite.</p>
    </div>
    <p class="copy">Blasphem checks one message at a time. It cannot see the full conversation or decide your community policy. Use its verdict as one input to your product.</p>
    <p class="copy">The engine combines a trained model with deterministic rules. Both run locally, in your client or server.</p>
    <p class="copy">The test benchmark records <b>{formatPercent(pooledPrecision)} precision</b> and <b>{formatPercent(pooledRecall)} recall</b> across all languages. It warns on {formatPercent(cleanWarned)} of {formatInt(cleanRows)} clean test messages. Many toxic messages still go undetected.</p>
    <p class="copy">Performance varies by language. Read <a href="#reckoning">the full benchmark</a> before choosing where to use a warning.</p>
  </div>
</Spread>

<style>
  .page.l {
    position: relative;
  }
  .emblem {
    position: absolute;
    right: 8%;
    top: 64px;
    width: 260px;
    height: 312px;
    color: var(--blood);
    opacity: 0.1;
    z-index: -1;
    pointer-events: none;
  }
  .creed {
    margin: 0 0 22px;
    max-width: 24ch;
    font-family: var(--font-goth);
    font-size: clamp(24px, 2vw, 32px);
    line-height: 1.2;
    color: var(--blood-ink);
  }
  .antiphon {
    margin: 0 0 26px;
    padding-left: 18px;
    border-left: 1px solid var(--blood-hair);
  }
  .but {
    margin: 0;
    font-family: var(--font-goth);
    font-size: clamp(22px, 1.9vw, 30px);
    line-height: 1.25;
  }
  .but {
    color: var(--bone);
  }
  @media (max-width: 1023px) {
    .emblem {
      width: 160px;
      height: 192px;
      right: 0;
      top: 40px;
    }
  }
</style>
