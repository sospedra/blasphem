---
import { LANGUAGES } from "../lib/languages";
import { SAMPLES } from "../lib/samples";
import Numeral from "./Numeral.astro";
import Spread from "./Spread.astro";

const samples = SAMPLES.map((sample) => ({ code: sample.code, tag: sample.tag, text: sample.text }));
const sampleJson = JSON.stringify(samples).replaceAll("<", "\\u003c");
---
<Spread id="detector" label="the detector" class="solo">
  <div class="stage">
    <header class="intro">
      <Numeral value="I" />
      <p class="rubric">chapter one</p>
      <h2 id="detector-title" class="title">Speak and be judged</h2>
      <p class="copy">Write below. The judge wakes on your first keystroke, then rules on every one after it. Leave the tongue on <b>AUTO</b> and the router picks from fifteen, or name it yourself. Nothing you type is sent anywhere.</p>
    </header>

    <div class="detector grained" id="playground" data-state="idle">
      <svg class="corner tl" viewBox="0 0 48 48" aria-hidden="true"><use href="#quatrefoil"></use></svg>
      <svg class="corner br" viewBox="0 0 48 48" aria-hidden="true"><use href="#quatrefoil"></use></svg>

      <div class="head">
        <label class="tongue">
          <span class="rubric mute">tongue</span>
          <select id="language">
            <option value="AUTO" selected>AUTO · detect the language</option>
            {LANGUAGES.map((language) => (
              <option value={language.code}>{language.code} · {language.name}{language.code === "MS" ? " (alias ID)" : ""}</option>
            ))}
          </select>
        </label>
        <button type="button" id="sample" class="sample">
          <svg viewBox="0 0 24 26" aria-hidden="true"><use href="#cross"></use></svg>
          <span>Try a sample</span>
        </button>
      </div>

      <div class="pane">
        <textarea id="message" rows="4" dir="auto" spellcheck="false" aria-label="Message to check" placeholder="Write the message you are about to send"></textarea>
      </div>

      <p class="status" id="status" role="status" aria-live="polite"></p>

      <div class="verdict" id="verdict" data-tone="waiting">
        <div class="ruling">
          <strong class="word">
            <svg class="ring thorns" viewBox="0 0 200 200" aria-hidden="true"><use href="#thornRing"></use></svg>
            <svg class="ring halo" viewBox="0 0 200 200" aria-hidden="true"><circle cx="100" cy="100" r="66" stroke-width="1"></circle></svg>
            <span id="ruling"></span>
          </strong>
          <span class="clock" id="clock"></span>
        </div>
        <p class="note" id="note"></p>
        <p class="visually-hidden" id="announce" role="status" aria-live="polite" aria-atomic="true"></p>
        <div class="meter" aria-hidden="true"><i id="bar"></i></div>
        <dl class="fields">
          <div><dt>safe</dt><dd id="f-safe"></dd></div>
          <div><dt>score</dt><dd id="f-score"></dd></div>
          <div><dt>locale</dt><dd id="f-locale"></dd></div>
          <div class="wide"><dt>grawlix</dt><dd id="f-grawlix"></dd></div>
        </dl>
      </div>

      <div class="failure" id="failure" hidden>
        <p id="failure-message"></p>
        <button type="button" class="act ghost" id="retry">Try again</button>
      </div>
    </div>

    <p class="evidence">samples from {samples.length} cases in the native smoke report</p>
  </div>
</Spread>

<script type="application/json" id="sample-data" set:html={sampleJson}></script>

<script>
  import { mountPlayground } from "../scripts/playground";

  const root = document.getElementById("playground");
  if (root) mountPlayground(root);
</script>

<style>
  .stage {
    width: 100%;
  }
  .intro {
    width: min(100%, 720px);
    margin: 0 auto 34px;
    text-align: center;
  }
  .intro :global(.numeral) {
    margin: -18px 0 4px;
    font-size: 168px;
  }
  .intro .copy {
    max-width: 58ch;
    margin-inline: auto;
  }
  .detector {
    position: relative;
    width: min(100%, 680px);
    margin: 0 auto;
    border: 1px solid var(--hair);
    background: linear-gradient(180deg, var(--coal), #080707);
    box-shadow: 0 40px 90px rgba(0, 0, 0, 0.55);
    transition: border-color var(--dur-slow) var(--ease-out);
  }
  .detector[data-state="loading"] {
    border-color: var(--ochre);
  }
  .detector[data-state="error"],
  .detector[data-state="unavailable"] {
    border-color: var(--blood-hair);
  }
  .corner {
    position: absolute;
    width: 22px;
    height: 22px;
    color: var(--blood);
    opacity: 0.5;
    pointer-events: none;
  }
  .corner.tl { top: -11px; left: -11px; background: var(--pitch); }
  .corner.br { bottom: -11px; right: -11px; background: var(--pitch); }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    padding: 12px 18px;
    border-bottom: 1px solid var(--hair);
  }
  .tongue {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .tongue .rubric {
    margin: 0;
  }
  select {
    background: var(--pitch);
    border: 1px solid var(--hair);
    color: var(--bone);
    font-family: var(--font-mono);
    font-size: 13px;
    padding: 8px 10px;
    min-height: 40px;
  }
  .sample {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 8px 14px;
    cursor: pointer;
    background: transparent;
    border: 1px solid var(--blood-hair);
    color: var(--blood-ink);
    font-family: var(--font-goth);
    font-size: 15px;
    transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
  .sample svg {
    width: 9px;
    height: 11px;
    fill: currentColor;
  }
  .sample:active {
    transform: scale(0.97);
  }
  .sample:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  @media (hover: hover) and (pointer: fine) {
    .sample:hover:not(:disabled) {
      background: rgba(226, 49, 39, 0.1);
      color: var(--bone);
    }
  }
  .pane {
    padding: 18px;
  }
  textarea {
    width: 100%;
    height: 132px;
    resize: none;
    background: transparent;
    border: none;
    color: var(--bone);
    font-family: var(--font-body);
    font-size: 20px;
    line-height: 1.5;
  }
  textarea:focus-visible {
    outline: 2px solid var(--blood-ink);
    outline-offset: 6px;
  }
  textarea::placeholder {
    color: var(--taupe);
  }
  .status {
    margin: 0;
    padding: 0 18px 14px;
    height: calc(3.2em + 14px);
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.6;
    color: var(--taupe-ink);
  }
  .detector[data-state="loading"] .status {
    color: var(--ochre);
    animation: pulse 1.2s ease-in-out infinite;
  }
  .verdict {
    position: relative;
    isolation: isolate;
    border-top: 1px solid var(--hair);
    padding: 18px 18px 20px;
    transition: background var(--dur-slow) var(--ease-out), border-color var(--dur-slow) var(--ease-out);
  }
  .verdict[data-tone="hit"] {
    background: linear-gradient(180deg, rgba(74, 20, 24, 0.55), rgba(74, 20, 24, 0));
    border-top-color: var(--blood-hair);
  }
  .ruling {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    height: 84px;
  }
  .word {
    position: relative;
    display: flex;
    align-items: center;
    height: 84px;
    font-family: var(--font-goth);
    font-weight: 400;
    font-size: 72px;
    line-height: 1;
    color: var(--taupe);
    transition: color var(--dur-slow) var(--ease-out), text-shadow var(--dur-slow) var(--ease-out);
  }
  .verdict[data-tone="hit"] .word {
    color: var(--blood);
    text-shadow: 0 0 30px rgba(226, 49, 39, 0.45);
  }
  .verdict[data-tone="clean"] .word {
    color: var(--bone);
  }
  .verdict[data-tone="unknown"] .word {
    color: var(--taupe-ink);
  }
  .ring {
    position: absolute;
    left: -0.32em;
    top: 50%;
    transform: translateY(-50%);
    width: 1.7em;
    height: 1.7em;
    z-index: -1;
    fill: none;
    opacity: 0;
    transition: opacity var(--dur-slow) var(--ease-out);
  }
  .ring.thorns { stroke: var(--blood); }
  .ring.halo { stroke: var(--ochre); }
  .verdict[data-tone="hit"] .ring.thorns,
  .verdict[data-tone="clean"] .ring.halo {
    opacity: 0.9;
  }
  .clock {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--taupe-ink);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .note {
    margin: 6px 0 0;
    height: 1.6em;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--taupe-ink);
  }
  .meter {
    position: relative;
    height: 2px;
    background: rgba(236, 231, 222, 0.12);
    margin: 16px 0 14px;
  }
  .meter i {
    display: block;
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: left center;
    background: var(--blood);
    box-shadow: 0 0 10px rgba(226, 49, 39, 0.8);
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .meter::after {
    content: "";
    position: absolute;
    top: -5px;
    left: 50%;
    width: 1px;
    height: 12px;
    background: var(--bone);
    opacity: 0.6;
  }
  .fields {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin: 0;
  }
  .fields div {
    border: 1px solid var(--hair);
    padding: 8px 10px;
    height: 58px;
    overflow: hidden;
  }
  .fields .wide {
    grid-column: 1 / -1;
    height: 86px;
  }
  .fields dt {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--taupe-ink);
  }
  .fields dd {
    margin: 2px 0 0;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--bone);
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }
  .failure {
    border-top: 1px solid var(--blood-hair);
    padding: 16px 18px 18px;
  }
  .failure p {
    margin: 0 0 12px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--blood-ink);
    word-break: break-word;
  }
  .evidence {
    display: block;
    width: min(100%, 680px);
    margin: 16px auto 0;
    text-align: center;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.55; }
  }
  @media (max-width: 1023px) {
    .status {
      height: calc(4.8em + 14px);
    }
    .word {
      font-size: clamp(40px, 12vw, 64px);
      height: 72px;
    }
    .ruling {
      height: 72px;
    }
    .fields {
      grid-template-columns: repeat(2, 1fr);
    }
    .corner {
      display: none;
    }
  }
</style>
